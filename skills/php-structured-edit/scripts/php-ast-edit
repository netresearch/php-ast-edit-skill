#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_BIN="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd)/bin/php-ast-edit"

# Release archives carry their matching engine, independent of the caller's PATH.
if [ -f "$SCRIPT_DIR/php-ast-edit.phar" ]; then
  exec php "$SCRIPT_DIR/php-ast-edit.phar" "$@"
fi

if [[ -x "$REPO_BIN" && ! "$REPO_BIN" -ef "${BASH_SOURCE[0]}" ]]; then
  exec "$REPO_BIN" "$@"
fi

if [[ -x "./vendor/bin/php-ast-edit" && ! ./vendor/bin/php-ast-edit -ef "${BASH_SOURCE[0]}" ]]; then
  exec ./vendor/bin/php-ast-edit "$@"
fi

PATH_BIN="$(command -v php-ast-edit || true)"
if [[ -n "$PATH_BIN" && -x "$PATH_BIN" && ! "$PATH_BIN" -ef "${BASH_SOURCE[0]}" ]]; then
  exec "$PATH_BIN" "$@"
fi

echo "php-ast-edit executable not found. Install the package with Composer or place php-ast-edit.phar next to this wrapper." >&2
exit 127

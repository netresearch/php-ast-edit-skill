#!/usr/bin/env php
<?php
declare(strict_types=1);

$root = dirname(__DIR__);
$autoload = $root.'/vendor/autoload.php';

if (is_file($autoload)) {
    require $autoload;
} else {
    spl_autoload_register(static function (string $class) use ($root): void {
        $prefix = 'Netresearch\\PhpAstEdit\\';
        if (!str_starts_with($class, $prefix)) {
            return;
        }
        $relative = str_replace('\\', '/', substr($class, strlen($prefix)));
        $file = $root.'/src/'.$relative.'.php';
        if (is_file($file)) {
            require $file;
        }
    });
}

if (!class_exists(PhpParser\ParserFactory::class)) {
    if (in_array($argv[1] ?? '', ['help', '--help', '-h'], true) || !isset($argv[1])) {
        fwrite(STDERR, "warning: nikic/php-parser is not installed; parsing commands require composer install\n");
    } else {
        fwrite(STDERR, "php-ast-edit requires nikic/php-parser. Run composer install or use the release PHAR.\n");
        exit(4);
    }
}

exit((new Netresearch\PhpAstEdit\Application())->run($argv));
